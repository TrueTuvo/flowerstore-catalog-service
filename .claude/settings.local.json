{
  "permissions": {
    "allow": [
      "Bash(./mvnw.cmd test *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(.\\\\mvnw.cmd spring-boot:run)",
      "PowerShell(docker volume ls *)",
      "PowerShell(docker exec *)",
      "PowerShell(.\\\\mvnw.cmd spring-boot:run \"-Dspring-boot.run.jvmArguments=-Duser.timezone=Europe/Kyiv\")",
